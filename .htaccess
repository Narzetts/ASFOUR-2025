# ==============================================================================
# ASFOUR v1.0.1 — Apache Root Configuration
# ==============================================================================

# 1. Matikan Directory Browsing / Listing
Options -Indexes

# 2. Blokir Eksekusi & Akses Skrip di Folder uploads/
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Cegah eksekusi skrip apapun di dalam uploads/
    RewriteRule ^uploads/.*\.(php[0-9]?|phtml|phar|pl|py|cgi|asp|sh|bash)$ - [F,NC,L]
</IfModule>

# 3. Header Keamanan Dasar
<IfModule mod_headers.c>
    # Mencegah MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Mencegah Clickjacking (hanya izinkan domain yang sama)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Filter XSS untuk browser yang mendukung
    Header set X-XSS-Protection "1; mode=block"

    # Kebijakan Referrer yang aman
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Lindungi File Sensitif (Dump Database, File Konfigurasi, Log)
<FilesMatch "^(asfourmy_asfour\.sql|\.htaccess|php\.ini|error_log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

